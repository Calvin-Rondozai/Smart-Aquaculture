FLASK_ENV=development
SECRET_KEY=change-me

DATABASE_URL=sqlite:///instance/aquaculture.db

ESP32_API_KEY=change-me

FISH_DETECTION_MODEL_PATH=models/fish_detection/cfd-yolov12x-1.00.pt
FISH_DETECTION_CONFIDENCE_THRESHOLD=0.25
# "stub" (no model needed), "cfd" (Community Fish Detector, AGPL, broad multi-dataset
# training), or "tilapia" (species-specific pose model — unverified accuracy, no
# declared license; local evaluation only, see TilapiaPoseDetector's docstring).
FISH_DETECTION_BACKEND=cfd
TILAPIA_MODEL_PATH=models/fish_detection/tilapia-pose-yolov8n.pt
# Inference resolution. 1024 = CFD's native training resolution (best recall, several
# seconds per analysis on CPU). If you switch to the "tilapia" backend, drop this to
# 640 (its native YOLOv8 training resolution) instead. Drop lower than that if you
# need faster updates more than maximum recall.
FISH_DETECTION_IMGSZ=1024

CAMERA_FRAME_INTERVAL=5
MAX_IMAGE_UPLOAD_MB=8

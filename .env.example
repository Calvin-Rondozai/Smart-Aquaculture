FLASK_ENV=development
SECRET_KEY=change-me

DATABASE_URL=sqlite:///instance/aquaculture.db

ESP32_API_KEY=change-me

FISH_DETECTION_MODEL_PATH=models/fish_detection/cfd-yolov12x-1.00.pt
FISH_DETECTION_CONFIDENCE_THRESHOLD=0.25
# Set to "stub" to run without real model weights, or "cfd" once ultralytics + weights are installed.
FISH_DETECTION_BACKEND=cfd
# Inference resolution for the CFD model. 1024 = native training resolution (best recall,
# several seconds per analysis on CPU). Drop to 640 or lower if you need faster updates more
# than maximum recall.
FISH_DETECTION_IMGSZ=1024

CAMERA_FRAME_INTERVAL=5
MAX_IMAGE_UPLOAD_MB=8

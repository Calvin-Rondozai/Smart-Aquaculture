FLASK_ENV=development
SECRET_KEY=change-me

DATABASE_URL=sqlite:///instance/aquaculture.db

ESP32_API_KEY=change-me

FISH_DETECTION_MODEL_PATH=models/fish_detection/cfd-yolov12x-1.00.pt
FISH_DETECTION_CONFIDENCE_THRESHOLD=0.25
# "stub" (no model needed), "cfd" (Community Fish Detector, AGPL — verified against
# real koi pond footage, finds real fish confidently), or "tilapia" (species-specific
# pose model, no declared license — verified NOT to detect anything on that same real
# koi footage, even at confidence 0.05; only use it against real tilapia footage, and
# check it actually finds fish before trusting it for anything).
FISH_DETECTION_BACKEND=cfd
TILAPIA_MODEL_PATH=models/fish_detection/tilapia-pose-yolov8n.pt
# Inference resolution. For CFD, only takes effect on the plain .pt (CPU) path — an
# OpenVINO export bakes in a fixed resolution at export time, so changing this does
# nothing until you re-export at the new size (see README). 640 measured ~180ms per
# analysis on an Intel iGPU and still found real fish confidently; 1024 measured
# ~690ms for barely better confidence; 480 started missing a weaker real detection.
FISH_DETECTION_IMGSZ=640

CAMERA_FRAME_INTERVAL=5
MAX_IMAGE_UPLOAD_MB=8
